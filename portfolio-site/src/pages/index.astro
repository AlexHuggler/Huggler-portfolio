---
import BaseLayout from "../layouts/BaseLayout.astro";
import StackPill from "../components/StackPill.astro";
import FeaturedProjectCard from "../components/FeaturedProjectCard.astro";
import HeroPipeline from "../components/hero/HeroPipeline.astro";
import Headshot from "../components/Headshot.astro";
import Stat from "../components/Stat.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../site.config";
import { measured, projectMetrics } from "../data/measured";

const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order);

const focus = [
  "Streaming + lakehouse architectures",
  "Cloud data platforms on Azure and AWS",
  "Analytics engineering with dbt + data contracts",
  "Applied AI for data engineering productivity",
];

const stackGroups = [
  {
    label: "Streaming & processing",
    items: ["Apache Kafka", "PySpark", "Delta Lake"],
  },
  {
    label: "Lakehouse & warehousing",
    items: ["Apache Iceberg", "Databricks", "Snowflake"],
  },
  {
    label: "Orchestration & modeling",
    items: ["Apache Airflow", "Azure Data Factory", "dbt"],
  },
  {
    label: "Languages & IaC",
    items: ["Python", "SQL", "Terraform"],
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  jobTitle: siteConfig.title,
  url: Astro.site?.toString(),
  sameAs: [siteConfig.github, siteConfig.linkedin],
  knowsAbout: [
    "Data Engineering",
    "Apache Spark",
    "Azure Databricks",
    "PySpark",
    "dbt",
    "Apache Airflow",
    "Snowflake",
    "Delta Lake",
    "Apache Iceberg",
    "Apache Kafka",
  ],
};
---

<BaseLayout
  title={`${siteConfig.name} - ${siteConfig.title}`}
  description={siteConfig.valueProp}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section id="hero" class="relative">
    <div class="absolute inset-0 grid-bg pointer-events-none" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div
      class="relative mx-auto grid max-w-page items-center gap-10 px-6 pt-16 pb-12 md:pt-20 md:pb-16 lg:grid-cols-[1.1fr_minmax(0,480px)] lg:gap-14"
    >
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-muted">
          {siteConfig.tagline}
        </p>
        <h1 class="mt-4 text-4xl md:text-6xl font-semibold tracking-tight max-w-prose">
          {siteConfig.name}
        </h1>
        <p class="mt-5 max-w-prose text-lg text-muted leading-relaxed">
          {siteConfig.valueProp}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a class="btn btn-primary" href="/projects">View projects</a>
          <a class="btn" href={siteConfig.resumePath}>Download resume</a>
          <a class="btn" href="/contact">Contact me</a>
        </div>
        <div class="mt-4 flex flex-wrap items-center gap-4 text-sm">
          <a
            href={siteConfig.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-fg rounded-sm"
            aria-label="Alex's GitHub profile (opens in new tab)"
          >
            GitHub <span aria-hidden="true">↗</span>
          </a>
          <a
            href={siteConfig.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-fg rounded-sm"
            aria-label="Alex's LinkedIn profile (opens in new tab)"
          >
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="hidden md:block">
        <HeroPipeline />
      </div>
    </div>

    <!-- Measured metrics band -->
    <div class="relative mx-auto max-w-page px-6 pb-16 md:pb-20">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {measured.site.map((m) => (
          <Stat value={m.value} label={m.label} sublabel={m.sublabel} />
        ))}
      </div>
      <p class="mt-3 font-mono text-[11px] text-muted/80">
        Measured on each project's local demo path, synthetic data, seed 42 —
        methodology in every repo's Results section.
      </p>
    </div>
  </section>

  <!-- Featured projects -->
  <section
    class="mx-auto max-w-page px-6 pt-4 pb-20 md:pt-6 md:pb-24"
    aria-labelledby="featured-heading"
  >
    <div class="flex items-end justify-between mb-6">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-muted">
          Selected work
        </p>
        <h2
          id="featured-heading"
          class="mt-2 text-xl md:text-2xl font-semibold tracking-tight"
        >
          Featured projects
        </h2>
      </div>
      <a
        href="/projects"
        class="text-sm text-muted hover:text-fg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg rounded-sm"
        aria-label="View all projects"
      >
        All projects
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {projects.map((p, i) => (
        <FeaturedProjectCard
          slug={p.slug}
          index={i + 1}
          title={p.data.title}
          problem={p.data.problem}
          approach={p.data.approach}
          demonstrates={p.data.demonstrates}
          stack={p.data.stack}
          repoUrl={p.data.repoUrl}
          metric={projectMetrics(p.slug)[0]}
        />
      ))}
    </div>
    <p class="mt-6 text-sm text-muted">
      Prefer charts to code?
      <a
        href="/visualizations"
        class="text-accent hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg rounded-sm"
      >
        Explore the interactive data visualizations
        <span aria-hidden="true">→</span>
      </a>
      built from these same pipelines.
    </p>
  </section>

  <!-- About + current focus + stack -->
  <section
    class="mx-auto max-w-prose px-6 pb-20"
    aria-labelledby="about-heading"
  >
    <div class="flex flex-col-reverse items-start gap-8 sm:flex-row sm:justify-between">
      <div class="min-w-0">
        <p class="font-mono text-xs uppercase tracking-widest text-muted">About</p>
        <h2
          id="about-heading"
          class="mt-2 text-xl md:text-2xl font-semibold tracking-tight"
        >
          Senior data &amp; analytics engineer
        </h2>
        <div class="mt-4 space-y-4 text-muted leading-relaxed">
          <p>
            I'm a senior data and analytics engineer with six years at AT&amp;T
            building production data platforms on Azure and Databricks — PySpark
            ingestion, dbt analytics models, BI delivery, streaming systems, and
            data quality. I treat tests, observability, runbooks, and data
            contracts as part of the deliverable, not as follow-ups.
          </p>
          <p>
            Recent impact includes identifying or enabling
            <span class="text-fg">$900K+/yr</span> in fraud-loss reduction and
            supporting analytics for a
            <span class="text-fg">$2.2B</span> portfolio of revenue and
            operational data — work that spans streaming detection, lakehouse
            design, and BI delivery on AT&amp;T's data platform.
          </p>
        </div>
        <p class="mt-4 font-mono text-xs text-muted">
          {siteConfig.location} · open to senior data / analytics engineering roles
        </p>
      </div>
      <Headshot size={144} class="shrink-0" />
    </div>
    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class="font-mono text-[11px] uppercase tracking-widest text-muted">
        Certified
      </span>
      <span class="pill"><span class="text-accent-fg">DP-203</span>&nbsp;Azure Data Engineering</span>
      <span class="pill"><span class="text-accent-fg">DP-100</span>&nbsp;Azure AI Engineering</span>
    </div>

    <h3 class="mt-10 text-sm font-mono uppercase tracking-widest text-muted">
      Current focus
    </h3>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2">
      {focus.map((f) => (
        <li class="focus-item">{f}</li>
      ))}
    </ul>

    <h3 class="mt-10 text-sm font-mono uppercase tracking-widest text-muted">
      Stack
    </h3>
    <div class="mt-3 space-y-4">
      {stackGroups.map((group) => (
        <div>
          <p class="font-mono text-[11px] text-muted/80">{group.label}</p>
          <ul class="mt-1.5 flex flex-wrap gap-1.5">
            {group.items.map((s) => (
              <li>
                <StackPill label={s} />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Contact CTA -->
  <section
    class="mx-auto max-w-page px-6 pb-24"
    aria-labelledby="contact-cta-heading"
  >
    <div class="card-glow rounded-lg border border-border p-8 md:p-10">
      <p class="font-mono text-xs uppercase tracking-widest text-muted">
        Let's talk
      </p>
      <h2
        id="contact-cta-heading"
        class="mt-2 text-xl md:text-2xl font-semibold tracking-tight max-w-prose"
      >
        Interested in data platforms, analytics engineering, or BI automation?
      </h2>
      <p class="mt-3 max-w-prose text-muted leading-relaxed">
        I'm open to senior data engineering, analytics engineering, and data
        platform consulting conversations.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/contact">Contact me</a>
        <a class="btn" href={siteConfig.resumePath}>View resume</a>
        <a
          class="btn"
          href={siteConfig.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Alex's GitHub profile (opens in new tab)"
        >
          GitHub
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /**
   * Cursor-reactive hero glow. Cheap rAF-throttled mouse tracking. The
   * decorative .hero-node pulses come from CSS; both respect
   * prefers-reduced-motion.
   */
  const bindHeroGlow = () => {
    const hero = document.getElementById("hero");
    if (!hero || hero.dataset.glowBound === "true") return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) return;
    hero.dataset.glowBound = "true";
    let frame = 0;
    hero.addEventListener("mousemove", (e) => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        const rect = hero.getBoundingClientRect();
        const x = (e as MouseEvent).clientX - rect.left;
        const y = (e as MouseEvent).clientY - rect.top;
        hero.style.setProperty("--mouse-x", `${x}px`);
        hero.style.setProperty("--mouse-y", `${y}px`);
        frame = 0;
      });
    });
  };
  bindHeroGlow();
  document.addEventListener("astro:after-swap", bindHeroGlow);
</script>
