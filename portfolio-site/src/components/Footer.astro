---
import { execSync } from "node:child_process";
import { siteConfig } from "../site.config";
import { measured, measuredLabel } from "../data/measured";

const columns = [
  {
    label: "Work",
    links: [
      { href: "/projects", label: "Projects" },
      { href: "/projects/fraud-signals", label: "Fraud Signals" },
      { href: "/projects/telecom-lakehouse", label: "Telecom Lakehouse" },
      { href: "/projects/ai-sql-optimizer", label: "SQL Optimizer" },
    ],
  },
  {
    label: "Explore",
    links: [
      { href: "/visualizations", label: "Dashboards" },
      { href: "/evidence", label: "Evidence ledger" },
      { href: "/about", label: "About" },
      { href: "/resume", label: "Résumé" },
    ],
  },
];

let sha = "dev";
try {
  sha = execSync("git rev-parse --short HEAD", { stdio: ["ignore", "pipe", "ignore"] })
    .toString()
    .trim();
} catch {
  /* not a git checkout */
}
const year = new Date().getFullYear();
---

<footer data-site-footer class="mt-24 border-t border-border">
  <div class="container-page py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div>
        <p class="font-display text-base font-semibold tracking-tight">{siteConfig.name}</p>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-muted">
          {siteConfig.title} in {siteConfig.location}. Production data platforms,
          analytics engineering, and applied AI for data teams.
        </p>
        <p class="mt-4 inline-flex items-center gap-2 font-mono text-[11px] text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-success" aria-hidden="true"></span>
          Open to senior DE / AE roles
        </p>
      </div>
      {columns.map((col) => (
        <nav aria-label={`Footer — ${col.label}`}>
          <p class="kicker">{col.label}</p>
          <ul class="mt-4 space-y-2.5 text-sm">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="rounded-sm text-muted hover:text-fg">{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
      <div>
        <p class="kicker">Contact</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href={`mailto:${siteConfig.email}`} class="rounded-sm text-muted hover:text-fg">{siteConfig.email}</a></li>
          <li>
            <a href={siteConfig.linkedin} target="_blank" rel="noopener noreferrer" class="rounded-sm text-muted hover:text-fg">
              LinkedIn <span aria-hidden="true">↗</span><span class="sr-only">(opens in new tab)</span>
            </a>
          </li>
          <li>
            <a href={siteConfig.github} target="_blank" rel="noopener noreferrer" class="rounded-sm text-muted hover:text-fg">
              GitHub <span aria-hidden="true">↗</span><span class="sr-only">(opens in new tab)</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-border pt-6 font-mono text-[11px] text-muted md:flex-row md:items-center md:justify-between">
      <p>
        © {year} {siteConfig.name} · Demo metrics last measured {measuredLabel()} on synthetic data (seed 42) —
        <a href="/evidence" class="link">methodology</a>
      </p>
      <p class="flex items-center gap-3">
        <span>Astro · ECharts · Tailwind</span>
        <span aria-hidden="true">·</span>
        <a href={`${siteConfig.githubRepo}/commit/${sha}`} target="_blank" rel="noopener noreferrer" class="hover:text-fg" title={`Built from commit ${sha}; measurements from ${measured.measuredOn}`}>
          build {sha}<span class="sr-only"> (opens in new tab)</span>
        </a>
      </p>
    </div>
  </div>
</footer>
