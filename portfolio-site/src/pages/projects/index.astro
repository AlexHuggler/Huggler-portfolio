---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/shared/SectionHeader.astro";
import { projectMetrics } from "../../data/measured";
import { capabilityMatrix, matrixProjects } from "../../data/capability-matrix";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const bySlug = new Map(projects.map((p) => [p.slug, p]));
const assets = import.meta.glob<{ default: ImageMetadata }>("/src/assets/projects/*.{png,svg}", { eager: true });
const preview = (file?: string) => (file ? assets[`/src/assets/projects/${file}`]?.default : undefined);
const previewAlt: Record<string, string> = {
  "fraud-signals": "Streamlit fraud dashboard: KPI tiles, events over time, anomalies by kind",
  "telecom-lakehouse": "Terminal capture of make demo: Bronze, Silver and Gold row counts",
  "ai-sql-optimizer": "Terminal capture of the analyzer's colour-coded findings table",
};
const statusLabel: Record<string, string> = {
  measured: "Measured",
  implemented: "Implemented",
  stub: "Stub",
  "needs-infra": "Needs infra",
  planned: "Planned",
};
const short: Record<string, string> = {
  "fraud-signals": "Fraud Signals",
  "telecom-lakehouse": "Telecom Lakehouse",
  "ai-sql-optimizer": "SQL Optimizer",
};
---

<BaseLayout
  title="Projects"
  description="Three end-to-end data engineering projects — streaming fraud detection, a medallion lakehouse, and LLM-assisted SQL review — with an honest capability matrix and measured results."
>
  <section class="relative overflow-hidden border-b border-border">
    <div class="absolute inset-0 grid-bg pointer-events-none" aria-hidden="true"></div>
    <div class="container-page relative py-16 md:py-20">
      <p class="kicker">Projects</p>
      <h1 class="display-2 mt-4 max-w-[20ch]">Three systems, measured end to end.</h1>
      <p class="lede mt-5">
        Each repo runs locally on synthetic data, ships CI, and publishes what it
        measured — and what it hasn't. The matrix below says exactly which parts
        are measured, built, stubbed, or waiting on infrastructure.
      </p>
    </div>
  </section>

  <section class="container-page py-16 md:py-20" aria-labelledby="cards-title">
    <h2 id="cards-title" class="sr-only">Project case studies</h2>
    <div class="grid gap-5 lg:grid-cols-3">
      {projects.map((p, i) => {
        const img = preview(p.data.screenshot);
        const m = projectMetrics(p.slug)[0];
        return (
          <article class="card card-interactive group flex flex-col overflow-hidden">
            <div class="aspect-[16/10] overflow-hidden border-b border-border bg-surface-2">
              {img && (
                <Image
                  src={img}
                  alt={previewAlt[p.slug] ?? p.data.title}
                  widths={[480, 800]}
                  sizes="(min-width: 1024px) 380px, 100vw"
                  class:list={["h-full w-full transition-transform duration-500 group-hover:scale-[1.02]", p.data.screenshot?.endsWith(".svg") ? "object-contain p-4" : "object-cover object-top"]}
                />
              )}
            </div>
            <div class="flex flex-1 flex-col p-5">
              <p class="font-mono text-[11px] text-muted">{String(i + 1).padStart(2, "0")} · {p.data.stack.slice(0, 3).join(" · ")}</p>
              <h3 class="mt-2 text-xl font-semibold tracking-tight">
                <a href={`/projects/${p.slug}`} class="rounded-sm after:absolute after:inset-0 hover:text-accent-fg" transition:name={`project-title-${p.slug}`}>
                  {p.data.title}
                </a>
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{p.data.problem}</p>
              {m && (
                <p class="mt-4 flex items-baseline gap-2 border-t border-border pt-4">
                  <span class="font-mono text-lg font-semibold">{m.value}</span>
                  <span class="text-xs text-muted">{m.label}</span>
                </p>
              )}
              <p class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent-fg">
                Read the case study <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
              </p>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section id="matrix" class="container-page scroll-mt-20 pb-8" aria-labelledby="matrix-title">
    <SectionHeader
      eyebrow="Capability matrix"
      title="What each project actually covers"
      description="The same engineering concerns down the side and an honest status per project. A dash means the concern is out of scope for that project."
    />
    <div class="card overflow-x-auto">
      <table class="matrix w-full min-w-[720px] text-left text-sm">
        <caption class="sr-only">Capability status by project</caption>
        <thead>
          <tr>
            <th scope="col" class="w-[24%]">Capability</th>
            {matrixProjects.map((slug) => (
              <th scope="col"><a href={`/projects/${slug}`} class="hover:text-fg">{short[slug] ?? bySlug.get(slug)?.data.title}</a></th>
            ))}
          </tr>
        </thead>
        <tbody>
          {capabilityMatrix.map((row) => (
            <tr>
              <th scope="row" class="font-medium text-fg">{row.area}</th>
              {matrixProjects.map((slug) => {
                const c = row.cells[slug];
                return (
                  <td>
                    {c ? (
                      <div>
                        <span class="status-chip" data-status={c.status}>{statusLabel[c.status]}</span>
                        <p class="mt-1.5 text-xs leading-snug text-muted">{c.note}</p>
                      </div>
                    ) : (
                      <span class="text-border-strong" aria-label="out of scope">—</span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-xs text-muted">
      <div class="flex items-center gap-2"><dt><span class="status-chip" data-status="measured">Measured</span></dt><dd>numbers published from a make target</dd></div>
      <div class="flex items-center gap-2"><dt><span class="status-chip" data-status="implemented">Implemented</span></dt><dd>works, not separately measured</dd></div>
      <div class="flex items-center gap-2"><dt><span class="status-chip" data-status="needs-infra">Needs infra</span></dt><dd>runs with docker compose / a cluster</dd></div>
      <div class="flex items-center gap-2"><dt><span class="status-chip" data-status="stub">Stub</span></dt><dd>scaffolded, not functional end to end</dd></div>
    </dl>
  </section>
</BaseLayout>

<style>
  .matrix th,
  .matrix td {
    @apply border-b border-border px-4 py-3 align-top;
  }
  .matrix thead th {
    @apply bg-surface-2 py-3 font-mono text-[10.5px] font-medium uppercase tracking-[0.12em] text-muted;
  }
  .matrix tbody tr:last-child th,
  .matrix tbody tr:last-child td {
    @apply border-b-0;
  }
  .matrix tbody tr:hover td,
  .matrix tbody tr:hover th {
    background: rgb(var(--color-accent) / 0.03);
  }
</style>
