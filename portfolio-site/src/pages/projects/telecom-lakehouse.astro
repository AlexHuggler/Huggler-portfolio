---
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import MermaidBlock from "../../components/MermaidBlock.astro";
import SectionHeader from "../../components/shared/SectionHeader.astro";
import MedallionDiagram from "../../components/lakehouse/MedallionDiagram.tsx";
import LayerDrillDown from "../../components/lakehouse/LayerDrillDown.tsx";
import AirflowDagViewer from "../../components/lakehouse/AirflowDagViewer.tsx";
import DataQualityScorecard from "../../components/lakehouse/DataQualityScorecard.tsx";
import DbtLineagePreview from "../../components/lakehouse/DbtLineagePreview.tsx";

const stack = [
  {
    label: "Apache Airflow",
    rationale: "Orchestrates ingest/transform/dbt with retries and SLAs.",
  },
  {
    label: "Apache Iceberg",
    rationale: "Partition evolution, hidden partitioning, engine portability.",
  },
  {
    label: "MinIO / S3",
    rationale: "Local object storage with the production API surface.",
  },
  {
    label: "Great Expectations",
    rationale: "Column-level data contracts at Bronze.",
  },
  {
    label: "dbt",
    rationale: "Silver-to-Gold transforms with tests on every model.",
  },
  {
    label: "Terraform",
    rationale: "Provisions the AWS variant when deploying for real.",
  },
];
---

<CaseStudyLayout
  slug="telecom-lakehouse"
  eyebrow="Project 02 · Lakehouse + orchestration"
  heroDescription="Bronze, Silver, and Gold tiers built over synthetic Call Detail Records. Airflow orchestrates ingestion onto Iceberg-on-S3, Great Expectations specifies contracts at the boundary, and dbt models analyst-ready marts on top."
  heroLinks={[
    { href: "#drill-down", label: "Explore the tiers" },
    { href: "#architecture", label: "Architecture deep-dive" },
  ]}
  stack={stack}
>
  <div slot="hero-visual" class="mt-8 demo-card relative overflow-hidden">
    <MedallionDiagram client:visible scrollTargetId="drill-down" />
  </div>

  <!-- Layer drill-down -->
  <section class="demo-section" id="drill-down">
    <SectionHeader
      eyebrow="Tier drill-down"
      title="Bronze, Silver, Gold — what changes between them"
      description="Click a tier above or use the tabs below to see the schema, sample rows, transformations, and data-quality checks at each stage of the medallion."
    />
    <LayerDrillDown client:visible />
  </section>

  <!-- Airflow DAG -->
  <section class="demo-section" id="orchestration">
    <SectionHeader
      eyebrow="Orchestration"
      title="Daily Airflow DAG"
      description="A linear pipeline that generates synthetic CDR data, lands it on Bronze, validates with Great Expectations, normalizes into Silver, builds Gold marts via dbt, and notifies on completion."
    />
    <AirflowDagViewer client:visible />
  </section>

  <!-- Data quality scorecard -->
  <section class="demo-section" id="data-quality">
    <SectionHeader
      eyebrow="Data quality"
      title="Scorecard across the four pillars"
      description="Completeness, validity, uniqueness, and freshness — measured by the dbt + Great Expectations test surface and surfaced into a simple scorecard."
    />
    <DataQualityScorecard client:visible />
  </section>

  <!-- dbt lineage -->
  <section class="demo-section" id="lineage">
    <SectionHeader
      eyebrow="dbt lineage"
      title="From sources to marts"
      description="Hover or focus a model to see its source file. The graph mirrors the dbt project's actual model layout — 8 models, 41 passing tests."
    />
    <DbtLineagePreview client:visible />
  </section>

  <!-- Architecture -->
  <section class="demo-section" id="architecture">
    <SectionHeader
      eyebrow="Architecture"
      title="From producer to BI"
      description="The full pipeline from synthetic generator to BI consumers. The engineering narrative below covers the trade-offs reviewers ask about."
    />
    <div class="demo-card">
      <MermaidBlock code={`flowchart LR
        G[Synthetic CDR generator] -->|parquet| R[(MinIO/S3 raw zone)]
        R -->|Airflow ingest DAG| BR[(Iceberg Bronze)]
        BR -->|Airflow transform DAG\nGE checks| SI[(Iceberg Silver)]
        SI -->|dbt run| GO[(Gold marts\nrevenue_by_market, arpu_monthly, churn_signals)]
        GO --> BI[BI / consumers]
      `} />
    </div>
  </section>
</CaseStudyLayout>
