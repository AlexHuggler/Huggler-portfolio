---
/**
 * LineageExplorer — the real dbt graph (1 source + 8 models parsed from
 * dbt_telecom/models). Columns are dependency depth, edges are ref()/source()
 * calls, and the dashed edge is the relationships test. Selecting a model
 * traces its upstream and downstream and opens its SQL, materialization and
 * tests in the side panel. Server-rendered; a small script toggles state.
 */
import { Code } from "astro:components";
import { cssVarsTheme } from "../../lib/shiki-theme.mjs";
import { dbt } from "../../data/artifacts";

const SOURCE_ID = dbt.source.id;
type Node = { id: string; layer: "source" | "bronze" | "silver" | "gold"; parents: string[] };
const nodes: Node[] = [
  { id: SOURCE_ID, layer: "source", parents: [] },
  ...dbt.models.map((m) => ({ id: m.id, layer: m.layer, parents: [...m.refs, ...m.sources] })),
];
const byId = new Map(nodes.map((n) => [n.id, n]));
const depth = new Map<string, number>();
const depthOf = (id: string): number => {
  if (depth.has(id)) return depth.get(id)!;
  const n = byId.get(id)!;
  const d = n.parents.length ? Math.max(...n.parents.map(depthOf)) + 1 : 0;
  depth.set(id, d);
  return d;
};
nodes.forEach((n) => depthOf(n.id));
const cols = Math.max(...depth.values()) + 1;
const columns: Node[][] = Array.from({ length: cols }, (_, c) => nodes.filter((n) => depth.get(n.id) === c));

const W = 142, H = 54, GX = 30, GY = 26, PAD = 12;
const maxRows = Math.max(...columns.map((c) => c.length));
const width = PAD * 2 + cols * W + (cols - 1) * GX;
const height = PAD * 2 + maxRows * H + (maxRows - 1) * GY;
const pos = new Map<string, { x: number; y: number }>();
columns.forEach((col, c) => {
  const colH = col.length * H + (col.length - 1) * GY;
  const top = PAD + (height - PAD * 2 - colH) / 2;
  col.forEach((n, r) => pos.set(n.id, { x: PAD + c * (W + GX), y: top + r * (H + GY) }));
});

const edges = nodes.flatMap((n) => n.parents.map((p) => ({ from: p, to: n.id, kind: "ref" as const })));
const relEdges = dbt.models.flatMap((m) =>
  m.tests.filter((t) => t.type === "relationships" && t.to).map((t) => ({ from: m.id, to: t.to!, kind: "rel" as const })),
);
const curve = (a: { x: number; y: number }, b: { x: number; y: number }, rel = false) => {
  if (rel) {
    // test edge drawn underneath, from child back to the register
    const x1 = a.x + W / 2, y1 = a.y + H, x2 = b.x + W / 2, y2 = b.y + H;
    const dip = Math.max(y1, y2) + 34;
    return `M ${x1} ${y1} C ${x1} ${dip}, ${x2} ${dip}, ${x2} ${y2}`;
  }
  const x1 = a.x + W, y1 = a.y + H / 2, x2 = b.x, y2 = b.y + H / 2, mx = (x1 + x2) / 2;
  return `M ${x1} ${y1} C ${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`;
};
const graph = Object.fromEntries(nodes.map((n) => [n.id, n.parents]));
const models = new Map(dbt.models.map((m) => [m.id, m]));
const layerLabel = { source: "source", bronze: "bronze", silver: "silver", gold: "gold" } as const;
---

<div class="card overflow-hidden" data-lineage data-graph={JSON.stringify(graph)}>
  <div>
    <div class="min-w-0 border-b border-border">
      <div class="flex flex-wrap items-center justify-between gap-2 px-5 pt-4">
        <p class="text-[15px] font-semibold tracking-tight">dbt_telecom · {dbt.models.length} models, {dbt.testCount} tests</p>
        <span class="data-chip" data-kind="real" title={dbt._meta.note}>Parsed from the dbt project</span>
      </div>
      <div class="overflow-x-auto px-3 pb-4 pt-2">
        <div class="relative" style={`width:${width}px;height:${height + 40}px`}>
          <svg class="absolute inset-0" width={width} height={height + 40} aria-hidden="true">
            <defs>
              <marker id="lin-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 0 L8 4 L0 8 z" class="lin-arrowhead" />
              </marker>
            </defs>
            {edges.map((e) => (
              <path d={curve(pos.get(e.from)!, pos.get(e.to)!)} class="lin-edge" data-from={e.from} data-to={e.to} marker-end="url(#lin-arrow)" />
            ))}
            {relEdges.map((e) => (
              <path d={curve(pos.get(e.from)!, pos.get(e.to)!, true)} class="lin-edge lin-edge-rel" data-from={e.from} data-to={e.to} />
            ))}
          </svg>
          {nodes.map((n) => {
            const p = pos.get(n.id)!;
            const m = models.get(n.id);
            return (
              <button
                type="button"
                class="lin-node"
                data-node={n.id}
                data-layer={n.layer}
                aria-pressed="false"
                style={`left:${p.x}px;top:${p.y}px;width:${W}px;height:${H}px`}
              >
                <span class:list={["block font-mono text-[9.5px] font-semibold uppercase tracking-[0.14em]", n.layer !== "source" && `tier-text-${n.layer}`, n.layer === "source" && "text-muted"]}>
                  {layerLabel[n.layer]}{m ? ` · ${m.materialized}` : ""}
                </span>
                <span class="mt-0.5 block truncate font-mono text-[12px] font-semibold text-fg" title={n.id}>{n.id}</span>
              </button>
            );
          })}
          <p class="absolute bottom-0 left-4 flex items-center gap-2 font-mono text-[10px] text-muted">
            <svg width="28" height="6" aria-hidden="true"><path d="M0 3 H28" class="lin-edge lin-edge-rel" /></svg>
            relationships test
          </p>
        </div>
      </div>
    </div>

    <aside class="bg-surface-2/50 p-5 md:p-6" aria-live="polite">
      <div data-lin-empty>
        <p class="kicker">Model detail</p>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Select a model to trace its upstream and downstream, and to read its SQL and tests.
        </p>
        <dl class="mt-5 grid max-w-md grid-cols-4 gap-3">
          {(["bronze", "silver", "gold"] as const).map((layer) => (
            <div class="flex flex-col">
              <dt class={`order-2 font-mono text-[10px] uppercase tracking-wider tier-text-${layer}`}>{layer}</dt>
              <dd class="order-1 font-mono text-lg font-semibold">{dbt.models.filter((m) => m.layer === layer).length}</dd>
            </div>
          ))}
          <div class="flex flex-col">
            <dt class="order-2 font-mono text-[10px] uppercase tracking-wider text-muted">tests</dt>
            <dd class="order-1 font-mono text-lg font-semibold">{dbt.testCount}</dd>
          </div>
        </dl>
      </div>
      {nodes.map((n) => {
        const m = models.get(n.id);
        const children = nodes.filter((c) => c.parents.includes(n.id)).map((c) => c.id);
        const tests = m ? m.tests : dbt.source.tests;
        return (
          <div data-lin-detail={n.id} hidden class="grid gap-6 lg:grid-cols-2">
            <div>
            <p class="kicker">{n.layer}{m ? ` · materialized as ${m.materialized}` : " · external Parquet"}</p>
            <p class="mt-2 font-mono text-base font-semibold">{n.id}</p>
            <p class="mt-1 text-sm leading-relaxed text-muted">{m ? m.description : dbt.source.description}</p>
            <dl class="spec mt-4 !gap-y-1 text-[12px]">
              <dt>Reads</dt><dd class="font-mono text-[11px]">{n.parents.join(", ") || "—"}</dd>
              <dt>Feeds</dt><dd class="font-mono text-[11px]">{children.join(", ") || "—"}</dd>
            </dl>
            <p class="kicker mt-5">{tests.length} tests</p>
            <ul class="mt-2 space-y-1">
              {tests.map((t) => (
                <li class="flex items-baseline justify-between gap-3 text-[12px]">
                  <span class="font-mono">{t.column}</span>
                  <span class="text-right font-mono text-[11px] text-muted">{t.type}{t.detail ? ` · ${t.detail}` : ""}</span>
                </li>
              ))}
            </ul>
            </div>
            {m && (
              <div class="min-w-0">
                <p class="kicker">SQL · {m.file.replace(/^project-telecom-lakehouse\//, "")}</p>
                <div class="code-surface mt-2 max-h-80 overflow-auto" data-code-copy>
                  <Code code={m.sql.trim()} lang="sql" theme={cssVarsTheme} />
                </div>
              </div>
            )}
          </div>
        );
      })}
    </aside>
  </div>
</div>

<script>
  const bind = () => {
    const root = document.querySelector<HTMLElement>("[data-lineage]");
    if (!root || root.dataset.bound === "1") return;
    root.dataset.bound = "1";
    const graph: Record<string, string[]> = JSON.parse(root.dataset.graph ?? "{}");
    const children: Record<string, string[]> = {};
    Object.entries(graph).forEach(([id, parents]) => parents.forEach((p) => (children[p] ??= []).push(id)));
    const walk = (start: string, next: Record<string, string[]>) => {
      const out = new Set<string>();
      const stack = [...(next[start] ?? [])];
      while (stack.length) {
        const id = stack.pop()!;
        if (out.has(id)) continue;
        out.add(id);
        stack.push(...(next[id] ?? []));
      }
      return out;
    };
    const nodes = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-node]"));
    const edges = Array.from(root.querySelectorAll<SVGPathElement>("[data-from]"));
    const details = Array.from(root.querySelectorAll<HTMLElement>("[data-lin-detail]"));
    const empty = root.querySelector<HTMLElement>("[data-lin-empty]")!;
    let selected: string | null = null;

    const apply = () => {
      const up = selected ? walk(selected, graph) : new Set<string>();
      const down = selected ? walk(selected, children) : new Set<string>();
      nodes.forEach((n) => {
        const id = n.dataset.node!;
        n.setAttribute("aria-pressed", String(id === selected));
        n.dataset.state = !selected ? "" : id === selected ? "selected" : up.has(id) ? "up" : down.has(id) ? "down" : "dim";
      });
      // An edge is part of the trace when both ends sit on the same side of
      // the selection: both upstream (or the selection), or both downstream.
      const inUp = (id: string) => id === selected || up.has(id);
      const inDown = (id: string) => id === selected || down.has(id);
      edges.forEach((e) => {
        const from = e.dataset.from!;
        const to = e.dataset.to!;
        const on = !!selected && ((inUp(from) && inUp(to)) || (inDown(from) && inDown(to)));
        e.dataset.state = !selected ? "" : on ? "on" : "dim";
      });
      details.forEach((d) => (d.hidden = d.dataset.linDetail !== selected));
      empty.hidden = !!selected;
    };
    nodes.forEach((n) =>
      n.addEventListener("click", () => {
        selected = selected === n.dataset.node ? null : n.dataset.node!;
        apply();
      }),
    );
    root.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && selected) {
        selected = null;
        apply();
      }
    });
  };
  document.addEventListener("astro:page-load", bind);
</script>

<style>
  .lin-node {
    @apply absolute rounded-lg border border-border bg-surface px-3 py-2 text-left;
    box-shadow: var(--shadow-1), var(--highlight);
    transition: opacity var(--dur-2) ease, border-color var(--dur-2) ease, box-shadow var(--dur-2) ease;
  }
  .lin-node:hover {
    @apply border-border-strong;
  }
  .lin-node[data-layer="bronze"] { box-shadow: var(--shadow-1), inset 3px 0 0 rgb(var(--tier-bronze)); }
  .lin-node[data-layer="silver"] { box-shadow: var(--shadow-1), inset 3px 0 0 rgb(var(--tier-silver)); }
  .lin-node[data-layer="gold"] { box-shadow: var(--shadow-1), inset 3px 0 0 rgb(var(--tier-gold)); }
  .lin-node[data-state="selected"] {
    @apply border-accent;
    outline: 2px solid rgb(var(--color-accent) / 0.35);
    outline-offset: 2px;
  }
  .lin-node[data-state="up"],
  .lin-node[data-state="down"] {
    @apply border-accent/50;
  }
  .lin-node[data-state="dim"] {
    opacity: 0.35;
  }
  .lin-edge {
    fill: none;
    stroke: rgb(var(--color-border-strong));
    stroke-width: 1.5;
    transition: stroke var(--dur-2) ease, opacity var(--dur-2) ease;
  }
  .lin-edge-rel {
    stroke-dasharray: 4 4;
    stroke: rgb(var(--color-muted) / 0.7);
  }
  .lin-edge[data-state="on"] {
    stroke: rgb(var(--color-accent));
    stroke-width: 2;
  }
  .lin-edge[data-state="dim"] {
    opacity: 0.25;
  }
  .lin-arrowhead {
    fill: rgb(var(--color-border-strong));
  }
</style>
