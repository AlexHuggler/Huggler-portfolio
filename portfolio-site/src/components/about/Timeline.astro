---
/**
 * Experience timeline — one entry per role on a vertical rail. Each role is
 * a native <details> (open by default, so no-JS and print show everything)
 * holding the summary, résumé-reported impact figures (projections labelled),
 * the bullets, and the stack used.
 */
import { roles, monthLabel, durationLabel } from "../../data/experience";
---

<ol class="timeline relative space-y-6">
  {roles.map((r, i) => (
    <li class="timeline-item relative pl-8 md:pl-10">
      <span class:list={["timeline-dot", i === 0 && "timeline-dot-current"]} aria-hidden="true" />
      <details class="card group overflow-hidden" open>
        <summary class="flex cursor-pointer list-none flex-wrap items-start justify-between gap-x-6 gap-y-2 p-5 md:p-6">
          <div class="min-w-0">
            <p class="font-mono text-[11px] text-muted">
              {monthLabel(r.start)} – {monthLabel(r.end)} · {durationLabel(r.start, r.end)}
              {!r.end && <span class="status-chip ml-2 align-middle" data-status="measured">Current</span>}
            </p>
            <h3 class="mt-2 text-lg font-semibold tracking-tight md:text-xl">{r.title}</h3>
            <p class="mt-0.5 text-sm text-muted">{r.company} · {r.location}</p>
          </div>
          <span class="mt-1 inline-flex items-center gap-1.5 font-mono text-[11px] text-muted no-print">
            <span class="group-open:hidden">Expand</span><span class="hidden group-open:inline">Collapse</span>
            <svg class="h-3 w-3 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </span>
        </summary>
        <div class="border-t border-border px-5 pb-6 pt-5 md:px-6">
          <p class="max-w-[72ch] leading-relaxed text-fg/90">{r.summary}</p>
          <dl class="mt-5 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-border bg-border lg:grid-cols-4">
            {r.impact.map((f) => (
              <div class="flex flex-col bg-surface-2 p-4">
                <dt class="order-2 mt-1.5 text-xs leading-snug text-muted">{f.label}</dt>
                <dd class="order-1 font-display text-xl font-semibold tracking-tight">{f.value}</dd>
                {f.kind === "projected" && (
                  <dd class="order-3 mt-2"><span class="status-chip" data-status="planned">Projected</span></dd>
                )}
              </div>
            ))}
          </dl>
          <ul class="mt-5 space-y-2.5">
            {r.bullets.map((b) => (
              <li class="focus-item text-[15px] text-fg/90">{b}</li>
            ))}
          </ul>
          <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Stack in this role">
            {r.stack.map((s) => <li class="pill text-muted">{s}</li>)}
          </ul>
        </div>
      </details>
    </li>
  ))}
</ol>

<style>
  .timeline::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: rgb(var(--color-border-strong));
  }
  @media (min-width: 768px) {
    .timeline::before { left: 9px; }
  }
  .timeline-dot {
    position: absolute;
    left: 2px;
    top: 1.6rem;
    width: 11px;
    height: 11px;
    border-radius: 9999px;
    background: rgb(var(--color-bg));
    border: 2px solid rgb(var(--color-border-strong));
  }
  @media (min-width: 768px) {
    .timeline-dot { left: 4px; }
  }
  .timeline-dot-current {
    border-color: rgb(var(--color-accent));
    box-shadow: 0 0 0 4px rgb(var(--color-accent) / 0.15);
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
