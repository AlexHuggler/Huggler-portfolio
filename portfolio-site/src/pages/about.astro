---
import BaseLayout from "../layouts/BaseLayout.astro";
import Headshot from "../components/Headshot.astro";
import { siteConfig } from "../site.config";
import { skills } from "../data/skills";

const levelStyle: Record<string, string> = {
  Expert: "text-accent-fg border-accent/40",
  Advanced: "text-fg border-border-strong",
  Working: "text-muted border-border",
};
---

<BaseLayout
  title="About"
  description={`About ${siteConfig.name} - senior data and analytics engineer with six years at AT&T.`}
>
  <section class="mx-auto max-w-prose px-6 pt-16 pb-24">
    <div class="flex flex-col-reverse items-start gap-8 sm:flex-row sm:justify-between">
      <div class="min-w-0">
        <p class="font-mono text-xs uppercase tracking-widest text-muted">About</p>
        <h1 class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">
          {siteConfig.name}
        </h1>
        <p class="mt-3 font-mono text-xs uppercase tracking-widest text-muted">
          Senior Data Engineer · Analytics Engineering · {siteConfig.location}
        </p>
        <div class="mt-6 space-y-5 text-muted leading-relaxed">
          <p>
            I'm a senior data and analytics engineer with six years at AT&amp;T
            building production data platforms on Azure and Databricks. My work
            spans PySpark ingestion, dbt analytics models, BI delivery, streaming
            systems, and data quality. I specialize in turning ambiguous fraud,
            revenue, and operational problems into reliable pipelines and
            decision-ready analytics.
          </p>
          <p>
            Recent impact: <span class="text-fg">$900K+/yr</span> fraud-loss
            reduction identified or enabled, analytics ownership of a
            <span class="text-fg">$2.2B</span> portfolio. Currently focused on
            streaming, lakehouse patterns, and applied AI for data engineering
            productivity. I treat tests, observability, runbooks, and data
            contracts as part of the deliverable.
          </p>
        </div>
      </div>
      <div class="flex shrink-0 flex-col items-center gap-4">
        <Headshot size={160} />
        <div class="w-full rounded-lg border border-border bg-surface p-4 text-sm">
          <p class="font-mono text-[10px] uppercase tracking-widest text-muted">
            Quick facts
          </p>
          <ul class="mt-2 space-y-1.5 text-muted">
            <li>{siteConfig.location}</li>
            <li>Open to senior DE / AE roles</li>
            <li>
              <a
                href={`mailto:${siteConfig.email}`}
                class="text-accent-fg hover:opacity-80 rounded-sm"
              >
                {siteConfig.email}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-2">
      <span class="font-mono text-[11px] uppercase tracking-widest text-muted">
        Certified
      </span>
      <span class="pill"><span class="text-accent-fg">DP-203</span>&nbsp;Azure Data Engineering</span>
      <span class="pill"><span class="text-accent-fg">DP-100</span>&nbsp;Azure AI Engineering</span>
    </div>

    <h2 class="mt-12 text-xl font-semibold tracking-tight">Skills matrix</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {skills.map((row) => (
        <div class="rounded-lg border border-border bg-surface p-4">
          <div class="flex items-baseline justify-between gap-2">
            <h3 class="text-sm font-semibold tracking-tight">{row.area}</h3>
            <span
              class:list={[
                "rounded-full border px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider",
                levelStyle[row.level],
              ]}
            >
              {row.level}
            </span>
          </div>
          <p class="mt-1.5 text-sm text-muted leading-relaxed">{row.tools}</p>
        </div>
      ))}
    </div>

    <h2 class="mt-12 text-xl font-semibold tracking-tight">Contact</h2>
    <ul class="mt-4 space-y-2 text-sm">
      <li>
        <span class="text-muted">GitHub:</span>{" "}
        <a
          class="text-accent-fg hover:opacity-80 rounded-sm"
          href={siteConfig.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Alex's GitHub profile (opens in new tab)"
        >
          {siteConfig.github.replace("https://", "")}
        </a>
      </li>
      <li>
        <span class="text-muted">LinkedIn:</span>{" "}
        <a
          class="text-accent-fg hover:opacity-80 rounded-sm"
          href={siteConfig.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Alex's LinkedIn profile (opens in new tab)"
        >
          {siteConfig.linkedin.replace("https://", "")}
        </a>
      </li>
      <li>
        <span class="text-muted">Resume:</span>{" "}
        <a
          class="text-accent-fg hover:opacity-80 rounded-sm"
          href={siteConfig.resumePath}
          aria-label="Download resume PDF"
        >
          download PDF
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>
