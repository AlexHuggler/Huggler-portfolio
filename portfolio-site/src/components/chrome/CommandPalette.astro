---
/**
 * CommandPalette — ⌘K / Ctrl+K / "/" anywhere. Markup + build-time index;
 * behaviour lives in src/scripts/palette.ts. Persisted across view
 * transitions so it binds exactly once.
 */
import { paletteItems } from "../../data/search-index";
---

<dialog id="cmdk" class="cmdk" aria-label="Command palette" transition:persist>
  <div class="cmdk-panel">
    <div class="cmdk-input-row">
      <svg class="h-4 w-4 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input
        data-cmdk-input
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmdk-list"
        aria-autocomplete="list"
        aria-label="Search pages, sections, metrics, and actions"
        placeholder="Search pages, sections, metrics…"
        autocomplete="off"
        spellcheck="false"
        class="cmdk-input"
      />
      <kbd>esc</kbd>
    </div>
    <ul id="cmdk-list" role="listbox" aria-label="Results" data-cmdk-list class="cmdk-list"></ul>
    <div class="cmdk-footer">
      <span><kbd>↑</kbd> <kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span class="ml-auto" data-cmdk-status role="status" aria-live="polite"></span>
    </div>
  </div>
</dialog>
<script is:inline type="application/json" id="cmdk-data" set:html={JSON.stringify(paletteItems)} />

<script>
  import "../../scripts/palette";
</script>

<style is:global>
  .cmdk {
    @apply m-0 mx-auto mt-[12vh] w-[min(640px,calc(100vw-1.5rem))] overflow-visible bg-transparent p-0 text-fg;
  }
  .cmdk::backdrop {
    background: rgb(var(--color-bg) / 0.6);
    backdrop-filter: blur(4px);
  }
  .cmdk[open] .cmdk-panel {
    animation: cmdk-in var(--dur-2) var(--ease-out);
  }
  @keyframes cmdk-in {
    from { opacity: 0; transform: translateY(-6px) scale(0.985); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cmdk[open] .cmdk-panel { animation: none; }
  }
  .cmdk-panel {
    @apply overflow-hidden rounded-2xl border border-border-strong bg-surface;
    box-shadow: var(--shadow-3), var(--highlight);
  }
  .cmdk-input-row {
    @apply flex items-center gap-3 border-b border-border px-4;
  }
  .cmdk-input {
    @apply h-14 w-full bg-transparent text-[15px] text-fg outline-none placeholder:text-muted;
  }
  .cmdk-list {
    @apply max-h-[min(420px,60vh)] overflow-y-auto p-2;
  }
  .cmdk-group {
    @apply px-3 pb-1.5 pt-3 font-mono text-[10px] font-medium uppercase text-muted;
    letter-spacing: 0.14em;
  }
  .cmdk-option {
    @apply flex cursor-pointer items-baseline gap-3 rounded-lg px-3 py-2.5;
  }
  .cmdk-option[aria-selected="true"] {
    @apply bg-accent/10;
    box-shadow: inset 2px 0 0 rgb(var(--color-accent));
  }
  .cmdk-title {
    @apply min-w-0 truncate text-sm text-fg;
  }
  .cmdk-subtitle {
    @apply ml-auto shrink-0 truncate pl-2 font-mono text-[11px] text-muted;
    max-width: 45%;
  }
  .cmdk-hint {
    @apply font-mono text-xs text-muted;
  }
  .cmdk-empty {
    @apply px-3 py-8 text-center text-sm text-muted;
  }
  .cmdk-footer {
    @apply flex items-center gap-4 border-t border-border bg-surface-2 px-4 py-2.5 font-mono text-[11px] text-muted;
  }
</style>
