# Copy to .env and export it (`set -a; . ./.env; set +a`) - the CLI reads the
# process environment and does not load .env itself.
# Without ANTHROPIC_API_KEY, `analyze` runs heuristic-only and
# `benchmark --no-dry-run` exits with an error instead of scoring heuristics.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: Snowflake engine for `sql-optimizer benchmark --explain snowflake`.
# Required: account, user, password. The corpus tables must exist there.
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
# SNOWFLAKE_ROLE=
