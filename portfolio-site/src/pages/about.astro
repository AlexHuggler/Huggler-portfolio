---
import BaseLayout from "../layouts/BaseLayout.astro";
import Headshot from "../components/Headshot.astro";
import SectionHeader from "../components/shared/SectionHeader.astro";
import Timeline from "../components/about/Timeline.astro";
import { siteConfig } from "../site.config";
import { certifications, education } from "../data/credentials";
import { stack, projectNames } from "../data/stack";
import { yearsOfExperience } from "../data/experience";

const years = yearsOfExperience();
const production = stack.filter((s) => s.production);
const core = stack.filter((s) => !s.production && s.level === "core");
const familiar = stack.filter((s) => s.level === "familiar");
const columns = [
  { title: "Production at AT&T", note: "Named in my AT&T work on the résumé", items: production },
  { title: "Core skills", note: "Listed as working skills on the résumé", items: core },
  { title: "Familiar", note: "Listed as “familiar with” — used in portfolio builds", items: familiar },
];
---

<BaseLayout
  title="About"
  description={`About ${siteConfig.name} — senior data engineer with ${years} years at AT&T building PySpark and Delta Lake platforms for fraud and revenue analytics.`}
>
  <section class="relative overflow-hidden border-b border-border">
    <div class="absolute inset-0 grid-bg pointer-events-none" aria-hidden="true"></div>
    <div class="container-page relative grid gap-12 py-16 md:py-20 lg:grid-cols-[1fr_320px]">
      <div>
        <p class="kicker">About</p>
        <h1 class="display-2 mt-4 max-w-[20ch]">
          An engineer who started on the business side of the data.
        </h1>
        <div class="mt-6 max-w-[64ch] space-y-5 text-[1.0625rem] leading-relaxed text-muted">
          <p>
            I came to data engineering through economics and business analytics,
            and spent my first years at AT&amp;T as the person who needed the data
            — building forecasts for a <span class="text-fg">~$2.2B/yr</span> portfolio
            and the datasets leadership read every week. That's where I learned that
            a pipeline is only as good as the decision it supports, and that the
            hardest part is usually agreeing what the numbers mean.
          </p>
          <p>
            Since 2023 I've owned production PySpark pipelines on Azure Databricks for
            Global Fraud Management: billing, device, and authentication data under
            daily and intraday SLAs, with data contracts and dimensional models agreed
            with the teams downstream. That work surfaced
            <span class="text-fg">1,200+</span> anomalous accounts and drove a
            <span class="text-fg">$900K/yr</span> reduction in fraud losses.
          </p>
          <p>
            I treat tests, observability, runbooks, and contracts as part of the
            deliverable, and I'm comfortable saying what isn't finished yet. The
            portfolio on this site is written in that spirit.
          </p>
        </div>
      </div>
      <aside class="flex flex-col gap-5">
        <Headshot size={176} class="self-start" />
        <dl class="spec card p-5">
          <dt>Based in</dt><dd>{siteConfig.location}</dd>
          <dt>Experience</dt><dd>{years} years, AT&amp;T</dd>
          <dt>Focus</dt><dd>Fraud & revenue data platforms</dd>
          <dt>Open to</dt><dd>Senior DE / AE roles — remote, hybrid, onsite</dd>
          <dt>Email</dt><dd><a class="link break-all" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></dd>
        </dl>
      </aside>
    </div>
  </section>

  <section id="experience" class="container-page scroll-mt-20 py-20">
    <SectionHeader
      index="01"
      eyebrow="Experience"
      title="Roles and what came out of them"
      description="Impact figures are as reported on my résumé; projections are labelled as projections."
      action={{ href: "/resume", label: "Résumé view" }}
    />
    <Timeline />
  </section>

  <section id="stack" class="container-page scroll-mt-20 pb-20">
    <SectionHeader
      index="02"
      eyebrow="Stack"
      title="Grouped by how I know it"
      description="Production experience, everyday skills, and tools I know from portfolio builds — kept apart so the list reads as evidence, not keywords."
    />
    <div class="grid gap-4 lg:grid-cols-3">
      {columns.map((c) => (
        <div class="card card-pad reveal">
          <h3 class="text-base font-semibold tracking-tight">{c.title}</h3>
          <p class="mt-1 text-xs text-muted">{c.note}</p>
          <ul class="mt-4 divide-y divide-border">
            {c.items.map((s) => (
              <li class="flex items-baseline justify-between gap-3 py-2 text-sm">
                <span>{s.name}</span>
                <span class="text-right font-mono text-[10px] text-muted">
                  {s.projects.map((p) => projectNames[p]).join(" · ")}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section id="education" class="container-page scroll-mt-20 pb-12">
    <SectionHeader index="03" eyebrow="Credentials" title="Education and certifications" />
    <div class="grid gap-4 md:grid-cols-2">
      {education.map((e) => (
        <div class="card card-pad">
          <p class="kicker">{e.degree} · {e.honors}</p>
          <h3 class="mt-3 text-lg font-semibold tracking-tight">{e.field}</h3>
          <p class="mt-1 text-sm text-muted">{e.school}</p>
        </div>
      ))}
      {certifications.map((c) => (
        <div class="card card-pad">
          <p class="kicker">{c.issuer} certified · {c.code}</p>
          <h3 class="mt-3 text-lg font-semibold tracking-tight">{c.name}</h3>
          <p class="mt-1 text-sm text-muted">Microsoft Certified: {c.name} ({c.code})</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
