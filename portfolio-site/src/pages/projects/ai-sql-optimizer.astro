---
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import TerminalFrame from "../../components/shared/TerminalFrame.astro";
import QueryWorkbench from "../../components/sqlopt/QueryWorkbench.astro";
import RuleCoverage from "../../components/sqlopt/RuleCoverage.astro";
import KeywordAttributionChart from "../../components/sqlopt/KeywordAttributionChart.tsx";
import transcript from "../../data/measurements/ai-sql-optimizer.txt?raw";
import { corpus } from "../../data/artifacts";
import { measuredLabel, metric } from "../../data/measured";

// The benchmark table exactly as `make benchmark` printed it.
const benchStart = transcript.indexOf("$ make benchmark");
const benchOutput = transcript
  .slice(benchStart)
  .split("\n")
  .slice(1)
  .filter((l) => !l.startsWith("uv run"))
  .join("\n")
  .trim();

const stack = [
  { label: "Python 3.11", rationale: "CLI runtime; typed dataclasses for findings and results." },
  { label: "sqlglot", rationale: "Dialect-aware SQL parser — the heuristics walk its AST instead of regexes." },
  { label: "Typer + Rich", rationale: "Ergonomic CLI with readable findings tables." },
  { label: "Anthropic SDK", rationale: "Claude Messages API with retry/backoff on rate limits and 5xx." },
  { label: "PyYAML", rationale: "Ground truth for the benchmark lives in reviewable YAML." },
  { label: "pytest", rationale: `${metric("sqlopt.tests").value} tests across analyzer, benchmark, CLI, client and EXPLAIN (API and engines mocked).` },
];
---

<CaseStudyLayout
  slug="ai-sql-optimizer"
  eyebrow="Project 03 · Applied AI for data engineering"
  heroDescription="A CLI that parses Spark and Snowflake SQL with sqlglot, flags anti-patterns with six heuristic rules, and sends the SQL plus structured findings to Claude for a rewrite. Everything below is the real corpus and real analyzer output — no simulated results."
  heroLinks={[
    { href: "#workbench", label: "Open the workbench" },
    { href: "#benchmark", label: "Benchmark, honestly" },
  ]}
  stack={stack}
  sections={[
    { id: "workbench", label: "Query workbench" },
    { id: "benchmark", label: "Benchmark" },
  ]}
>
  <TerminalFrame
    slot="hero-visual"
    class="mt-10 max-w-3xl"
    command="make benchmark"
    output={benchOutput}
    caption={`Captured by scripts/measure.py · ${measuredLabel()} · sqlglot ${corpus._meta.sqlglot}`}
  />

  <section id="workbench" class="cs-section" aria-labelledby="workbench-title">
    <p class="kicker">Query workbench</p>
    <h2 id="workbench-title" class="heading-1 mt-3">Five real queries, one anti-pattern each</h2>
    <p class="mt-3 max-w-[68ch] leading-relaxed text-muted">
      Pick a query to see what the analyzer actually reports, which ground-truth
      keywords it earns, a reference rewrite with its assumptions, and the exact
      message the CLI would send to Claude. Tabs deep-link (<code class="font-mono text-[0.9em]">#q1</code>–<code class="font-mono text-[0.9em]">#q5</code>).
    </p>
    <div class="mt-8">
      <QueryWorkbench />
    </div>
  </section>

  <section id="benchmark" class="cs-section" aria-labelledby="benchmark-title">
    <p class="kicker">Benchmark</p>
    <h2 id="benchmark-title" class="heading-1 mt-3">What the score does and doesn't measure</h2>
    <p class="mt-3 max-w-[68ch] leading-relaxed text-muted">
      The dry-run benchmark scores keyword overlap with ground truth and whether
      any finding fired. Both charts below come straight from the analyzer's output
      over the corpus, so the score's blind spots are visible rather than footnoted.
    </p>
    <div class="mt-8 space-y-5">
      <KeywordAttributionChart client:visible />
      <RuleCoverage />
      <div class="card card-pad">
        <p class="kicker">Evaluation status · not measured</p>
        <ul class="mt-4 grid gap-3 md:grid-cols-3">
          <li class="card-inset p-4 text-sm"><span class="status-chip" data-status="implemented">Built · not run</span><p class="mt-2 font-medium">Claude rewrite quality</p><p class="mt-1 text-muted"><code class="font-mono text-[0.9em]">--no-dry-run</code> scores Claude's rewrites with the same scorer, but it needs an API key and no live run is recorded yet.</p></li>
          <li class="card-inset p-4 text-sm"><span class="status-chip" data-status="needs-infra">Needs an engine</span><p class="mt-2 font-medium">EXPLAIN cost delta</p><p class="mt-1 text-muted"><code class="font-mono text-[0.9em]">--explain spark|snowflake</code> records estimated bytes scanned before and after; it needs an engine holding the corpus tables.</p></li>
          <li class="card-inset p-4 text-sm"><span class="status-chip" data-status="planned">Planned</span><p class="mt-2 font-medium">Human acceptance</p><p class="mt-1 text-muted">Reviewer accept/reject with rationale per suggestion, as the corpus grows.</p></li>
        </ul>
      </div>
    </div>
  </section>
</CaseStudyLayout>
