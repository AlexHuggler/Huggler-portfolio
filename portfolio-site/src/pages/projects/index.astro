---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectPreviewCard from "../../components/shared/ProjectPreviewCard.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { projectMetrics } from "../../data/measured";

const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order);

/**
 * Card previews are real artifacts from the projects themselves — the
 * Streamlit dashboard screenshot and terminal captures generated by each
 * repo's demo path — not illustrations.
 */
const assets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/*.{png,svg}",
  { eager: true },
);
function preview(filename: string | undefined): ImageMetadata | undefined {
  if (!filename) return undefined;
  return assets[`/src/assets/projects/${filename}`]?.default;
}

const previewAlt: Record<string, string> = {
  "fraud-signals":
    "Streamlit fraud dashboard: KPI tiles, events-over-time line chart, and anomalies by kind",
  "telecom-lakehouse":
    "Terminal capture of make demo: 50k CDRs generated, then Bronze, Silver, and Gold row counts",
  "ai-sql-optimizer":
    "Terminal capture of sql-optimizer analyze: color-coded analyzer findings table",
};
---

<BaseLayout
  title="Projects"
  description="Production data engineering portfolio: streaming pipelines, lakehouse architectures, and AI tooling."
>
  <section class="mx-auto max-w-page px-6 pt-16 pb-8">
    <p class="font-mono text-xs uppercase tracking-widest text-muted">Projects</p>
    <h1 class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">Selected work</h1>
    <p class="mt-3 max-w-prose text-muted leading-relaxed">
      Three end-to-end projects showcasing streaming, lakehouse, and
      AI-assisted data engineering. Each repo runs locally with synthetic
      data, ships CI, and publishes measured results. The previews below are
      real artifacts from each project's demo path. Click any card for a
      live, interactive walkthrough of the architecture.
    </p>
  </section>

  <section class="mx-auto max-w-page px-6 pb-24">
    <div class="grid gap-5 lg:grid-cols-3">
      {projects.map((p, i) => {
        const img = preview(p.data.screenshot);
        return (
          <ProjectPreviewCard
            slug={p.slug}
            number={String(i + 1).padStart(2, "0")}
            title={p.data.title}
            tagline={p.data.tagline}
            stack={p.data.stack}
            repoUrl={p.data.repoUrl}
            demonstrates={p.data.demonstrates.slice(0, 3)}
            metric={projectMetrics(p.slug)[0]}
          >
            {img && (
              <Image
                slot="preview"
                src={img}
                alt={previewAlt[p.slug] ?? `${p.data.title} preview`}
                widths={[480, 800]}
                sizes="(min-width: 1024px) 380px, 100vw"
                class:list={[
                  "h-full w-full",
                  p.data.screenshot?.endsWith(".svg")
                    ? "object-contain p-3"
                    : "object-cover object-top",
                ]}
              />
            )}
          </ProjectPreviewCard>
        );
      })}
    </div>
  </section>
</BaseLayout>
