---
/**
 * TerminalFrame — real command output in a quiet terminal window. Used for
 * transcripts captured by scripts/measure.py, so the "screenshot" is text:
 * selectable, accessible, and theme-aware.
 */
interface Props {
  command: string;
  output: string;
  caption?: string;
  class?: string;
}
const { command, output, caption, class: className } = Astro.props;
---

<figure class:list={["terminal", className]}>
  <div class="terminal-bar" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
  <pre class="terminal-body" tabindex="0"><span class="terminal-prompt">$</span> {`${command}\n${output}`}</pre>
  {caption && <figcaption class="terminal-caption">{caption}</figcaption>}
</figure>

<style>
  .terminal {
    @apply overflow-hidden rounded-xl border border-border bg-surface;
    box-shadow: var(--shadow-3), var(--highlight);
  }
  .terminal-bar {
    @apply flex items-center gap-1.5 border-b border-border px-3 py-2.5;
  }
  .terminal-bar > span {
    @apply h-2.5 w-2.5 rounded-full bg-border-strong;
  }
  .terminal-body {
    @apply overflow-x-auto bg-surface-2 p-4 font-mono text-[11.5px] leading-[1.55] text-fg/90;
  }
  .terminal-prompt {
    @apply text-accent-fg;
  }
  .terminal-caption {
    @apply border-t border-border px-4 py-2 font-mono text-[10.5px] text-muted;
  }
</style>
