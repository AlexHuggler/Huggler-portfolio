---
/**
 * Editorial project row for the homepage: framed preview on one side, the
 * argument on the other (problem → approach → two measured results →
 * stack → actions). Rows alternate sides on wide screens.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { MeasuredMetric } from "../../data/measured";

interface Props {
  slug: string;
  index: number;
  title: string;
  problem: string;
  approach: string;
  stack: string[];
  repoUrl: string;
  metrics: MeasuredMetric[];
  image?: ImageMetadata;
  flip?: boolean;
}

const { slug, index, title, problem, approach, stack, repoUrl, metrics, image, flip } = Astro.props;
const num = String(index).padStart(2, "0");
---

<article class="reveal grid items-center gap-8 lg:grid-cols-12 lg:gap-12">
  <a
    href={`/projects/${slug}`}
    class:list={[
      "window-frame group block lg:col-span-7",
      flip && "lg:order-2",
    ]}
    tabindex="-1"
    aria-hidden="true"
  >
    <div class="window-bar">
      <span></span><span></span><span></span>
      <p class="ml-3 truncate font-mono text-[10px] text-muted">alexhuggler.com/projects/{slug}</p>
    </div>
    <div class="aspect-[16/10] overflow-hidden bg-surface-2">
      {image && (
        <Image
          src={image}
          alt=""
          widths={[560, 900, 1200]}
          sizes="(min-width: 1024px) 680px, 100vw"
          class:list={[
            "h-full w-full transition-transform duration-500 group-hover:scale-[1.015]",
            image.format === "svg" ? "object-contain p-6" : "object-cover object-top",
          ]}
        />
      )}
    </div>
  </a>

  <div class:list={["lg:col-span-5", flip && "lg:order-1"]}>
    <p class="flex items-center gap-3">
      <span class="kicker-index">{num}</span>
      <span class="h-px w-6 bg-border-strong" aria-hidden="true"></span>
      <span class="kicker">Case study</span>
    </p>
    <h3 class="heading-1 mt-3">
      <a href={`/projects/${slug}`} class="rounded-sm hover:text-accent-fg" transition:name={`project-title-${slug}`}>
        {title}
      </a>
    </h3>
    <p class="mt-4 leading-relaxed text-fg/90">{problem}</p>
    <p class="mt-3 font-mono text-[12px] leading-relaxed text-muted">{approach}</p>

    {metrics.length > 0 && (
      <dl class="mt-6 grid grid-cols-2 gap-4 border-y border-border py-4">
        {metrics.slice(0, 2).map((m) => (
          <div class="flex flex-col">
            <dt class="order-2 mt-1 text-xs leading-snug text-muted">{m.label}</dt>
            <dd class="order-1 font-mono text-xl font-semibold tracking-tight">{m.value}</dd>
          </div>
        ))}
      </dl>
    )}

    <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Stack">
      {stack.slice(0, 5).map((s) => <li class="pill text-muted">{s}</li>)}
    </ul>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a href={`/projects/${slug}`} class="btn btn-primary">
        Read the case study <span aria-hidden="true" class="btn-arrow">→</span>
      </a>
      <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
        Source <span aria-hidden="true">↗</span><span class="sr-only">(opens in new tab)</span>
      </a>
    </div>
  </div>
</article>

<style>
  .window-frame {
    @apply overflow-hidden rounded-xl border border-border bg-surface;
    box-shadow: var(--shadow-3), var(--highlight);
  }
  .window-bar {
    @apply flex items-center gap-1.5 border-b border-border bg-surface px-3 py-2.5;
  }
  .window-bar > span {
    @apply h-2.5 w-2.5 rounded-full bg-border-strong;
  }
</style>
