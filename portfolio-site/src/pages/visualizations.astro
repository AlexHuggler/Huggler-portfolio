---
import BaseLayout from "../layouts/BaseLayout.astro";
import TelecomDashboard from "../components/viz/TelecomDashboard.tsx";
import FraudDashboard from "../components/viz/FraudDashboard.tsx";
import SqlOptDashboard from "../components/viz/SqlOptDashboard.tsx";
import KeywordAttributionChart from "../components/sqlopt/KeywordAttributionChart.tsx";
import RuleCoverage from "../components/sqlopt/RuleCoverage.astro";

const tabs = [
  {
    id: "telecom",
    label: "Telecom revenue & usage",
    kicker: "Scenario data · dbt rules",
    blurb:
      "A year of simulated traffic for 1,200 subscribers, priced and aggregated with the lakehouse project's own dbt rules — pricing from sl_revenue_event, ARPU from arpu_monthly, risk tiers from churn_signals. Filter by market from the selector or by clicking a bar.",
    repo: "/projects/telecom-lakehouse",
    chip: { label: "Scenario · seed 42", kind: "synthetic" },
  },
  {
    id: "fraud",
    label: "Fraud detection",
    kicker: "Real make eval set",
    blurb:
      "Aggregated from the 16,664-event labeled evaluation set the fraud project generates: detector outcomes at account level, fraud and flags over the run, amount profiles by pattern, and a producer quirk worth knowing about.",
    repo: "/projects/fraud-signals",
    chip: { label: "Real · make eval", kind: "real" },
  },
  {
    id: "sqlopt",
    label: "SQL analyzer",
    kicker: "Real corpus",
    blurb:
      "The five-query corpus and the analyzer's actual findings. There are no cost-reduction charts here, because no cost reduction has been measured; the evaluation status is listed instead.",
    repo: "/projects/ai-sql-optimizer",
    chip: { label: "Real · analyze()", kind: "real" },
  },
];
---

<BaseLayout
  title="Dashboards"
  description="Interactive BI-style dashboards built with Apache ECharts: a telecom revenue scenario on the lakehouse's dbt rules, the fraud project's real evaluation set, and the SQL optimizer's real corpus."
>
  <section class="relative overflow-hidden border-b border-border">
    <div class="absolute inset-0 grid-bg pointer-events-none" aria-hidden="true"></div>
    <div class="container-page relative py-16 md:py-20">
      <p class="kicker">Dashboards</p>
      <h1 class="display-2 mt-4 max-w-[22ch]">The BI layer, rebuilt in the open.</h1>
      <p class="lede mt-5">
        The kind of executive dashboards I ship in Power BI and Tableau, rebuilt as
        self-hosted ECharts over the projects' own data. Every chart states its
        source, opens its data table, exports CSV, and expands full screen — and
        each takeaway is computed from the data, not written beside it.
      </p>
      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[11px] text-muted">
        <li class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-success" aria-hidden="true"></span>Real = exported from the projects</li>
        <li class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-accent-2" aria-hidden="true"></span>Scenario = simulated with the projects' rules, labelled</li>
      </ul>
    </div>
  </section>

  <div class="container-page py-10 md:py-12" data-tabs data-tabs-hash>
    <div class="sticky top-16 z-20 -mx-5 border-b border-border bg-bg/85 px-5 py-3 backdrop-blur-xl sm:-mx-6 sm:px-6">
      <div role="tablist" aria-label="Dashboards" class="segmented max-w-full overflow-x-auto">
        {tabs.map((t, i) => (
          <button
            role="tab"
            id={`dash-tab-${t.id}`}
            aria-controls={`dash-panel-${t.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            data-hash={t.id}
            class="whitespace-nowrap"
          >
            {t.label}
          </button>
        ))}
      </div>
    </div>

    {tabs.map((t, i) => (
      <section
        role="tabpanel"
        id={`dash-panel-${t.id}`}
        aria-labelledby={`dash-tab-${t.id}`}
        hidden={i !== 0}
        tabindex="-1"
        class="pt-8"
      >
        <header class="mb-6 flex flex-wrap items-end justify-between gap-4">
          <div class="max-w-3xl">
            <p class="kicker">{t.kicker}</p>
            <h2 class="heading-1 mt-2">{t.label}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{t.blurb}</p>
          </div>
          <a href={t.repo} class="btn btn-sm">Case study <span aria-hidden="true">→</span></a>
        </header>
        <div class="dash-shell">
          {t.id === "telecom" && <TelecomDashboard client:visible />}
          {t.id === "fraud" && <FraudDashboard client:visible />}
          {t.id === "sqlopt" && (
            <div class="space-y-5">
              <SqlOptDashboard client:visible />
              <KeywordAttributionChart client:visible />
              <RuleCoverage />
              <div class="card card-pad">
                <p class="kicker">Evaluation status · not measured</p>
                <p class="mt-2 max-w-[72ch] text-sm leading-relaxed text-muted">
                  Cost reduction needs EXPLAIN on a Spark or Snowflake engine holding the corpus
                  tables, and rewrite quality needs a live Claude run. Both are built into the
                  benchmark (<code class="font-mono text-[0.9em]">--explain</code>,
                  <code class="font-mono text-[0.9em]">--no-dry-run</code>), but no run is recorded,
                  so neither is charted. See the <a class="link" href="/evidence#not-measured">not-measured list</a>.
                </p>
              </div>
            </div>
          )}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  /* Reserve space so hydrating dashboards don't shift the page. */
  .dash-shell {
    min-height: 900px;
  }
</style>
