---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../site.config";

const inputClass =
  "mt-2 w-full rounded-md border border-border bg-surface px-3 py-2 text-fg placeholder-muted focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent";
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${siteConfig.name} — hiring, collaboration, or speaking inquiries.`}
>
  <section class="mx-auto max-w-page px-6 pt-16 pb-24">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-muted">Contact</p>
        <h1 class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">
          Send me a message
        </h1>
        <p class="mt-6 max-w-prose text-muted leading-relaxed">
          Best for hiring inquiries, collaboration on data engineering or
          analytics work, and speaking opportunities. I read every message
          and reply within a few business days.
        </p>

        <div class="mt-8 space-y-3">
          <div class="rounded-lg border border-border bg-surface p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-muted">
              Email directly
            </p>
            <a
              class="mt-1 inline-block text-sm text-accent-fg hover:opacity-80 rounded-sm"
              href={`mailto:${siteConfig.email}`}
            >
              {siteConfig.email}
            </a>
          </div>
          <div class="rounded-lg border border-border bg-surface p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-muted">
              Elsewhere
            </p>
            <p class="mt-1 space-x-4 text-sm">
              <a
                class="text-accent-fg hover:opacity-80 rounded-sm"
                href={siteConfig.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Alex's LinkedIn profile (opens in new tab)"
              >
                LinkedIn <span aria-hidden="true">↗</span>
              </a>
              <a
                class="text-accent-fg hover:opacity-80 rounded-sm"
                href={siteConfig.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Alex's GitHub profile (opens in new tab)"
              >
                GitHub <span aria-hidden="true">↗</span>
              </a>
            </p>
          </div>
        </div>
      </div>

      <div class="rounded-lg border border-border bg-surface p-6 md:p-8">
        <form
          action={siteConfig.contactFormEndpoint}
          method="POST"
          class="space-y-6"
        >
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" style="position:absolute; left:-10000px; top:auto; width:1px; height:1px; overflow:hidden;" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_subject" value="New message from www.alexhuggler.com" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_next" value="https://www.alexhuggler.com/contact/sent" />

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-sm font-medium">Name</label>
              <input id="name" name="name" type="text" required autocomplete="name" class={inputClass} />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium">Email</label>
              <input id="email" name="email" type="email" required autocomplete="email" class={inputClass} />
            </div>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="company" class="block text-sm font-medium">Company <span class="text-muted">(optional)</span></label>
              <input id="company" name="company" type="text" autocomplete="organization" class={inputClass} />
            </div>
            <div>
              <label for="subject" class="block text-sm font-medium">Subject <span class="text-muted">(optional)</span></label>
              <input id="subject" name="subject" type="text" class={inputClass} />
            </div>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium">Message</label>
            <textarea id="message" name="message" rows="6" required class={inputClass}></textarea>
          </div>

          <button type="submit" class="btn btn-primary">Send message</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
