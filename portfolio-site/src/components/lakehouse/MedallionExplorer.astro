---
/**
 * MedallionExplorer — the real make-demo output, layer by layer. A flow strip
 * of tier buttons (with real row counts) drives ARIA tabs; each tab shows the
 * DuckDB schema, masked sample rows, what the layer does, and the checks that
 * guard it. Data: scripts/artifacts/telecom.py.
 */
import { samples, contracts, dbt, type LayerSample } from "../../data/artifacts";

type TierKey = "bronze" | "silver" | "gold";
const fmt = (n: number) => n.toLocaleString("en-US");

const dbtTests = (layer: TierKey) => dbt.models.filter((m) => m.layer === layer).reduce((a, m) => a + m.tests.length, 0);

const tiers: {
  key: TierKey;
  label: string;
  rows: string;
  role: string;
  does: string[];
  checks: string[];
  tables: { name: string; data: LayerSample }[];
}[] = [
  {
    key: "bronze",
    label: "Bronze",
    rows: fmt(samples.layers.bronze.rows),
    role: "Typed, append-only copy of what landed",
    does: [
      "Reads raw Parquet with hive partitioning on ingest_date",
      "Casts types, upper-cases call_type and market, nulls empty callee",
      "Keeps every row so corrections can be replayed",
    ],
    checks: [`${contracts.expectations.length} Great Expectations rules (defined; checkpoint stubbed)`, `${dbtTests("bronze")} dbt tests on br_cdr and br_account_register`],
    tables: [{ name: "bronze/cdr.parquet", data: samples.layers.bronze }],
  },
  {
    key: "silver",
    label: "Silver",
    rows: fmt(samples.layers.silver.rows),
    role: "Valid, rated events",
    does: [
      "Drops rows without a caller, with negative duration, or an unknown call type",
      "Derives billable_minutes (ceil of seconds / 60, voice only) and billable_mb",
      "Normalises the roaming flag",
    ],
    checks: [`${dbtTests("silver")} dbt tests incl. a relationships test back to the account register`],
    tables: [{ name: "silver/cdr.parquet", data: samples.layers.silver }],
  },
  {
    key: "gold",
    label: "Gold",
    rows: `${samples.layers["gold.revenue_by_market"].rows} · ${samples.layers["gold.arpu_monthly"].rows} · ${fmt(samples.layers["gold.churn_signals"].rows)}`,
    role: "Marts BI reads: revenue, ARPU, churn",
    does: [
      "revenue_by_market: daily revenue at $0.05/billable min, $0.02/MB, $0.01/SMS",
      "arpu_monthly: average revenue per active caller, by plan and month",
      "churn_signals: per-caller activity bucketed into high / medium / low risk",
    ],
    checks: [`${dbtTests("gold")} dbt tests: accepted values, non-null keys, revenue ≥ 0`],
    tables: [
      { name: "gold/revenue_by_market", data: samples.layers["gold.revenue_by_market"] },
      { name: "gold/arpu_monthly", data: samples.layers["gold.arpu_monthly"] },
      { name: "gold/churn_signals", data: samples.layers["gold.churn_signals"] },
    ],
  },
];
const churnHigh = samples.gold.churnRisk.high ?? 0;
---

<div class="card overflow-hidden" data-tabs>
  <div role="tablist" aria-label="Medallion layers" class="grid border-b border-border md:grid-cols-[auto_repeat(3,minmax(0,1fr))]">
    <div class="hidden flex-col justify-center border-r border-border px-5 py-4 md:flex">
      <p class="kicker">Raw</p>
      <p class="mt-1 font-mono text-lg font-semibold">{fmt(samples.layers.bronze.rows)}</p>
      <p class="font-mono text-[10px] text-muted">{samples.partitions} partitions</p>
    </div>
    {tiers.map((t, i) => (
      <button
        role="tab"
        id={`tier-tab-${t.key}`}
        aria-controls={`tier-panel-${t.key}`}
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
        class="tier-tab"
        data-tier={t.key}
      >
        <span class:list={["font-mono text-[11px] font-semibold uppercase tracking-[0.14em]", `tier-text-${t.key}`]}>{t.label}</span>
        <span class="mt-1 block font-mono text-lg font-semibold text-fg">{t.rows}</span>
        <span class="block text-xs text-muted">{t.role}</span>
      </button>
    ))}
  </div>

  {tiers.map((t, i) => (
    <section role="tabpanel" id={`tier-panel-${t.key}`} aria-labelledby={`tier-tab-${t.key}`} hidden={i !== 0} tabindex="0" class="p-5 md:p-7">
      <div class="grid gap-5 lg:grid-cols-2">
        <div>
          <p class="kicker">What this layer does</p>
          <ul class="mt-3 space-y-2">{t.does.map((d) => <li class="focus-item text-[14px] text-fg/90">{d}</li>)}</ul>
        </div>
        <div>
          <p class="kicker">What guards it</p>
          <ul class="mt-3 space-y-2">{t.checks.map((c) => <li class="focus-item text-[14px] text-fg/90">{c}</li>)}</ul>
          {t.key === "gold" && (
            <p class="mt-4 rounded-lg border border-warn/30 bg-warn/5 p-3 text-[13px] leading-relaxed">
              <span class="font-semibold text-warn-fg">Finding · </span>
              all {fmt(churnHigh)} callers land in <code class="font-mono">high</code> churn risk: the generator
              draws a new MSISDN per record, so nobody has more than one event. The mart is
              right; the synthetic data isn't shaped for it.
            </p>
          )}
        </div>
      </div>

      {t.tables.map((tbl) => (
        <div class="mt-6">
          <p class="flex flex-wrap items-baseline justify-between gap-2">
            <span class="font-mono text-[12px] font-semibold">{tbl.name}</span>
            <span class="font-mono text-[11px] text-muted">{fmt(tbl.data.rows)} rows · {tbl.data.schema.length} columns</span>
          </p>
          <div class="mt-2 overflow-x-auto rounded-lg border border-border" tabindex="0" role="region" aria-label={`${tbl.name} sample rows (scrollable)`}>
            <table class="sample-table">
              <caption class="sr-only">{tbl.name}: schema and sample rows</caption>
              <thead>
                <tr>{tbl.data.schema.map((c) => (
                  <th scope="col">
                    <span class="block text-fg">{c.column}</span>
                    <span class="block font-normal text-muted">{c.type.toLowerCase()}</span>
                  </th>
                ))}</tr>
              </thead>
              <tbody>
                {tbl.data.sample.map((row) => (
                  <tr>{tbl.data.schema.map((c) => {
                    const v = row[c.column];
                    return <td>{v === null || v === undefined ? <span class="text-muted">null</span> : String(v)}</td>;
                  })}</tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
      <p class="mt-4 font-mono text-[10.5px] leading-relaxed text-muted">{samples._meta.note}</p>
    </section>
  ))}
</div>

<style>
  .tier-tab {
    @apply border-b border-border px-5 py-4 text-left md:border-b-0 md:border-r;
    transition: background-color var(--dur-2) ease;
  }
  .tier-tab:last-child {
    @apply border-r-0;
  }
  .tier-tab:hover {
    @apply bg-surface-2;
  }
  .tier-tab[aria-selected="true"] {
    @apply bg-surface-2;
    box-shadow: inset 0 -2px 0 rgb(var(--color-accent));
  }
  .tier-tab[data-tier="bronze"][aria-selected="true"] { box-shadow: inset 0 -2px 0 rgb(var(--tier-bronze)); }
  .tier-tab[data-tier="silver"][aria-selected="true"] { box-shadow: inset 0 -2px 0 rgb(var(--tier-silver)); }
  .tier-tab[data-tier="gold"][aria-selected="true"] { box-shadow: inset 0 -2px 0 rgb(var(--tier-gold)); }
  .sample-table {
    @apply w-full border-collapse text-left font-mono text-[11.5px];
  }
  .sample-table th {
    @apply whitespace-nowrap border-b border-border bg-surface-2 px-3 py-2 text-[10.5px] font-medium;
  }
  .sample-table td {
    @apply whitespace-nowrap border-b border-border px-3 py-1.5 text-fg/85;
  }
  .sample-table tr:last-child td {
    @apply border-b-0;
  }
</style>
