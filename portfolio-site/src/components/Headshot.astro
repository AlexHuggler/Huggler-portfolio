---
/**
 * Headshot — renders the real photo when one exists, else a deliberate,
 * branded monogram card. To activate the photo: drop `headshot.jpg` (or
 * .jpeg/.png/.webp) into src/assets/ and rebuild — no code change needed.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** Rendered box size in px (square). */
  size?: number;
  class?: string;
}
const { size = 160, class: className = "" } = Astro.props;

const matches = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/headshot.{jpg,jpeg,png,webp}",
  { eager: true },
);
const photo = Object.values(matches)[0]?.default;
---

{
  photo ? (
    <div
      class:list={[
        "headshot relative overflow-hidden rounded-2xl border border-border",
        className,
      ]}
      style={`width:${size}px;height:${size}px`}
    >
      <Image
        src={photo}
        alt="Portrait of Alex Huggler"
        width={size * 2}
        height={size * 2}
        class="h-full w-full object-cover"
      />
      <span class="headshot-ring" aria-hidden="true" />
    </div>
  ) : (
    <div
      class:list={[
        "headshot relative flex items-center justify-center overflow-hidden rounded-2xl border border-border bg-surface",
        className,
      ]}
      style={`width:${size}px;height:${size}px`}
      role="img"
      aria-label="Monogram placeholder for Alex Huggler"
    >
      <div class="absolute inset-0 grid-bg opacity-60" aria-hidden="true" />
      <span
        class="relative font-display text-4xl font-semibold tracking-tight text-gradient-accent"
        aria-hidden="true"
      >
        AH
      </span>
      <span class="headshot-ring" aria-hidden="true" />
    </div>
  )
}

<style>
  .headshot-ring {
    position: absolute;
    inset: 0;
    border-radius: 1rem;
    padding: 1px;
    background: var(--gradient-accent);
    opacity: 0.35;
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
</style>
