---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroPipeline from "../components/hero/HeroPipeline.astro";
import SectionHeader from "../components/shared/SectionHeader.astro";
import EvidenceSplit from "../components/home/EvidenceSplit.astro";
import WorkRow from "../components/home/WorkRow.astro";
import Principles from "../components/home/Principles.astro";
import ExperienceTeaser from "../components/home/ExperienceTeaser.astro";
import StackExplorer from "../components/home/StackExplorer.astro";
import { siteConfig } from "../site.config";
import { projectMetrics } from "../data/measured";
import { certifications, education } from "../data/credentials";
import { yearsOfExperience } from "../data/experience";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const assets = import.meta.glob<{ default: ImageMetadata }>("/src/assets/projects/*.{png,svg}", { eager: true });
const preview = (file?: string) => (file ? assets[`/src/assets/projects/${file}`]?.default : undefined);
const previewAlt: Record<string, string> = {
  "fraud-signals": "Streamlit fraud dashboard from the project's demo path",
  "telecom-lakehouse": "Terminal capture of make demo with Bronze, Silver and Gold row counts",
  "ai-sql-optimizer": "Terminal capture of the analyzer's findings table",
};
// Lead each project with its two most telling measured results.
const leadMetrics: Record<string, string[]> = {
  "fraud-signals": ["fraud.geo.pr", "fraud.throughput"],
  "telecom-lakehouse": ["telecom.dbt", "telecom.transform"],
  "ai-sql-optimizer": ["sqlopt.findings", "sqlopt.latency"],
};

const years = yearsOfExperience();
const masters = education[0];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  jobTitle: siteConfig.title,
  url: Astro.site?.toString(),
  email: `mailto:${siteConfig.email}`,
  address: { "@type": "PostalAddress", addressLocality: "Dallas", addressRegion: "TX", addressCountry: "US" },
  sameAs: [siteConfig.github, siteConfig.linkedin],
  alumniOf: education.map((e) => ({ "@type": "CollegeOrUniversity", name: e.school })),
  hasCredential: certifications.map((c) => ({
    "@type": "EducationalOccupationalCredential",
    name: `Microsoft Certified: ${c.name} (${c.code})`,
  })),
  knowsAbout: [
    "Data Engineering", "Apache Spark", "PySpark", "Azure Databricks", "Delta Lake",
    "dbt", "Apache Airflow", "Spark Structured Streaming", "Data contracts", "Dimensional modeling",
  ],
};
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.title}`}
  description={siteConfig.valueProp}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section id="hero" class="relative overflow-hidden border-b border-border">
    <div class="absolute inset-0 grid-bg pointer-events-none" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="container-page relative grid items-center gap-12 pb-16 pt-14 md:pb-20 md:pt-20 lg:grid-cols-[1.15fr_minmax(0,460px)] lg:gap-16">
      <div>
        <p class="kicker flex flex-wrap items-center gap-x-3 gap-y-1">
          <span class="text-fg">{siteConfig.name}</span>
          <span aria-hidden="true">/</span>
          <span>Senior Data Engineer</span>
          <span aria-hidden="true">/</span>
          <span>{siteConfig.location}</span>
        </p>
        <h1 class="display-1 mt-6 max-w-[15ch]">
          I build the data platforms fraud and revenue teams run on.
        </h1>
        <p class="lede mt-6">
          {years} years at AT&amp;T shipping PySpark and Delta Lake pipelines on Azure
          Databricks — nationwide fraud investigations, a ~$2.2B forecasting
          portfolio, daily and intraday SLAs. The three projects below show the
          same craft in code you can run, and every number on this site comes with
          its method.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a class="btn btn-primary btn-lg" href="#work">
            See the work <span aria-hidden="true" class="btn-arrow">↓</span>
          </a>
          <a class="btn btn-lg" href="/resume">Résumé</a>
          <a class="btn btn-ghost btn-lg" href="/contact">Get in touch</a>
        </div>
        <ul class="mt-10 flex flex-wrap gap-2" aria-label="Credentials">
          <li class="pill text-muted"><span class="font-semibold text-fg">{years} yrs</span> AT&amp;T data platforms</li>
          {certifications.map((c) => (
            <li class="pill text-muted"><span class="font-semibold text-accent-fg">{c.code}</span> {c.name}</li>
          ))}
          <li class="pill text-muted"><span class="font-semibold text-fg">{masters.degree}</span> {masters.field}, UT Dallas</li>
        </ul>
      </div>
      <div class="mx-auto w-full max-w-[460px]">
        <HeroPipeline />
      </div>
    </div>
  </section>

  <!-- 01 Evidence -->
  <section id="evidence" class="container-page scroll-mt-20 py-20 md:py-24" aria-labelledby="evidence-title">
    <SectionHeader
      index="01"
      eyebrow="Evidence"
      title="Two kinds of proof, kept apart on purpose"
      description="Production results from my AT&T roles sit on the left. On the right are numbers anyone can reproduce from the repos, each with its method one click away."
    />
    <EvidenceSplit />
  </section>

  <!-- 02 Work -->
  <section id="work" class="scroll-mt-20 border-y border-border bg-surface/40 py-20 md:py-24" aria-labelledby="work-title">
    <div class="container-page">
      <SectionHeader
        index="02"
        eyebrow="Selected work"
        title="Three systems, built the way I'd build them at work"
        description="Streaming detection, a medallion lakehouse, and LLM-assisted SQL review. Each runs locally on synthetic data, ships CI, and publishes what it measured and what it hasn't yet."
        action={{ href: "/projects", label: "Compare all projects" }}
      />
      <div class="space-y-20 md:space-y-24">
        {projects.map((p, i) => {
          const all = projectMetrics(p.slug);
          const lead = (leadMetrics[p.slug] ?? []).map((id) => all.find((m) => m.id === id)).filter((m) => m !== undefined);
          return (
            <WorkRow
              slug={p.slug}
              index={i + 1}
              title={p.data.title}
              problem={p.data.problem}
              approach={p.data.approach}
              stack={p.data.stack}
              repoUrl={p.data.repoUrl}
              metrics={lead}
              image={preview(p.data.screenshot)}
              imageAlt={previewAlt[p.slug] ?? p.data.title}
              flip={i % 2 === 1}
            />
          );
        })}
      </div>
      <p class="mt-16 text-sm text-muted">
        Prefer charts?
        <a href="/visualizations" class="link">Open the dashboards</a> built from the same pipelines.
      </p>
    </div>
  </section>

  <!-- 03 Principles -->
  <section id="principles" class="container-page scroll-mt-20 py-20 md:py-24">
    <SectionHeader
      index="03"
      eyebrow="How I work"
      title="Principles that show up in the details"
      description="Each one links to where it's practised, so none of them is a slogan."
    />
    <Principles />
  </section>

  <!-- 04 Experience -->
  <section id="experience" class="container-page scroll-mt-20 pb-20 md:pb-24">
    <SectionHeader
      index="04"
      eyebrow="Experience"
      title={`${years} years building data platforms at AT&T`}
      action={{ href: "/about", label: "About me" }}
    />
    <ExperienceTeaser />
  </section>

  <!-- 05 Stack -->
  <section id="stack" class="container-page scroll-mt-20 pb-20 md:pb-24">
    <SectionHeader
      index="05"
      eyebrow="Stack"
      title="Tools, filtered by evidence"
      description="Proficiency follows the résumé's own wording. Pick a tool to see whether it's production experience, a portfolio build, or familiarity."
    />
    <StackExplorer />
  </section>

  <!-- Contact CTA -->
  <section class="container-page pb-8" aria-labelledby="cta-title">
    <div class="card relative overflow-hidden p-8 md:p-12">
      <div class="absolute inset-0 grid-bg opacity-60 pointer-events-none" aria-hidden="true"></div>
      <div class="relative grid items-end gap-8 md:grid-cols-[1fr_auto]">
        <div>
          <p class="kicker">Let's talk</p>
          <h2 id="cta-title" class="heading-1 mt-3 max-w-[22ch]">
            Hiring for data platforms, analytics engineering, or fraud analytics?
          </h2>
          <p class="mt-3 max-w-[60ch] text-muted">
            I'm open to senior data engineering and analytics engineering roles, remote,
            hybrid, or onsite in Dallas.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-primary btn-lg" href="/contact">Contact me</a>
          <a class="btn btn-lg" href={siteConfig.resumePath}>Download résumé</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /** Cursor-reactive hero glow; rAF-throttled, skipped under reduced motion. */
  const bindHeroGlow = () => {
    const hero = document.getElementById("hero");
    if (!hero || hero.dataset.glowBound === "true") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    hero.dataset.glowBound = "true";
    let frame = 0;
    hero.addEventListener("pointermove", (e) => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        const rect = hero.getBoundingClientRect();
        hero.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
        hero.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
        frame = 0;
      });
    });
  };
  document.addEventListener("astro:page-load", bindHeroGlow);
</script>
