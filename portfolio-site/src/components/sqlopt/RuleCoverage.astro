---
/**
 * Rule × query coverage matrix from the analyzer's real output: which of the
 * six heuristic rules fire on which corpus query, with severity. Makes the
 * two rules the corpus never exercises impossible to miss.
 */
import { corpus } from "../../data/artifacts";
import { categoryTitle } from "../../data/sqlopt/rewrite-notes";

const rules = corpus.rules.filter((r) => r.id !== "parse_error");
const queries = corpus.queries;
---

<figure class="card overflow-hidden">
  <div class="flex flex-wrap items-start justify-between gap-3 px-5 pt-5">
    <div>
      <figcaption class="text-[15px] font-semibold tracking-tight">Rule coverage across the corpus</figcaption>
      <p class="mt-0.5 text-xs text-muted">Which heuristic fires on which query, from analyze() run exactly as the benchmark runs it.</p>
    </div>
    <span class="data-chip" data-kind="real" title="Real analyzer output over the five corpus queries.">Real analyzer output</span>
  </div>
  <div class="overflow-x-auto p-5" tabindex="0" role="region" aria-label="Rule coverage table (scrollable)">
    <table class="w-full min-w-[640px] border-separate border-spacing-0 text-sm">
      <thead>
        <tr>
          <th scope="col" class="cov-th !text-left">Rule</th>
          {queries.map((q) => (
            <th scope="col" class="cov-th" title={categoryTitle[q.category]}>
              <span class="font-mono">{String(q.n).padStart(2, "0")}</span>
              <span class="mt-0.5 block font-sans text-[10px] font-normal normal-case tracking-normal text-muted">{categoryTitle[q.category]}</span>
            </th>
          ))}
          <th scope="col" class="cov-th">Fires</th>
        </tr>
      </thead>
      <tbody>
        {rules.map((r) => (
          <tr class:list={[r.firesOn.length === 0 && "cov-never"]}>
            <th scope="row" class="cov-td !text-left font-normal">
              <span class="flex items-center gap-2">
                <span class="severity" data-severity={r.severity}>{r.severity}</span>
                <code class="font-mono text-[12px]">{r.id}</code>
              </span>
            </th>
            {queries.map((q) => {
              const hit = r.firesOn.includes(q.id);
              return (
                <td class="cov-td text-center">
                  {hit ? (
                    <span class="cov-dot" data-severity={r.severity} role="img" aria-label="fires" />
                  ) : (
                    <span class="text-border-strong" aria-label="does not fire">·</span>
                  )}
                </td>
              );
            })}
            <td class="cov-td text-center font-mono text-[12px]">
              {r.firesOn.length === 0 ? <span class="text-warn-fg">never</span> : r.firesOn.length}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="border-t border-border px-5 py-3 text-[13px] leading-relaxed text-fg/90">
    <span class="mr-1.5 font-mono text-[10px] font-medium uppercase tracking-[0.12em] text-accent-fg">Takeaway</span>
    {corpus.summary.rulesNeverFired.filter((r) => r !== "parse_error").join(" and ")} never fire here —
    the corpus needs a cross-join case, and the benchmark needs to pass partition columns.
  </p>
</figure>

<style>
  .cov-th {
    @apply border-b border-border px-3 pb-3 text-center font-mono text-[11px] font-medium uppercase tracking-wider text-muted;
  }
  .cov-td {
    @apply border-b border-border px-3 py-2.5;
  }
  tr:last-child .cov-td,
  tr:last-child th.cov-td {
    @apply border-b-0;
  }
  .cov-never .cov-td {
    background: rgb(var(--color-warn) / 0.05);
  }
  .cov-dot {
    @apply inline-block h-3 w-3 rounded-full;
    --sev: var(--color-accent-fg);
    background: rgb(var(--sev));
    box-shadow: 0 0 0 3px rgb(var(--sev) / 0.18);
  }
  .cov-dot[data-severity="warn"] { --sev: var(--color-warn); }
  .cov-dot[data-severity="high"] { --sev: var(--color-danger); }
</style>
